layout {

    focus-ring {
        active-color   "#ffb77e"
        inactive-color "#19120c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb77e"
        inactive-color "#19120c"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb77e"
        inactive-color "#6c3a07"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb77e80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb77e"
        urgent-color "#ffb4ab"
    }
}
