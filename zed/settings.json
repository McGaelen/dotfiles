    //   },
    //   "text": "#BDBDBD"
    // }
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_project_items": true,
    "show_sign_in": false
  },
  "ui_font_size": 17,
  "unnecessary_code_fade": 0.6,
  "use_system_window_tabs": false,
  "zoomed_padding": true
}
