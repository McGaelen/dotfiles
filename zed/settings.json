{
  "active_pane_modifiers": {
    "border_size": 0
  },
  "agent": {
    "sidebar_side": "right",
    "default_model": {
      "enable_thinking": false,
      "model": "prism-ml/bonsai-27b",
      "provider": "lmstudio"
    },
    "default_profile": "ask",
    "dock": "right",
    "model_parameters": [],
    "show_turn_stats": true
  },
  "agent_buffer_font_size": 13,
  "agent_servers": {
    "junie": {
      "default_config_options": {
        "effort": "medium",
        "model": "v1:12:jetbrains-ai:gpt-6-luna"
      },
      "type": "registry"
    }
  },
  "agent_ui_font_size": 17,
  "auto_update": false,
  "base_keymap": "JetBrains",
  "bottom_dock_layout": "contained",
  "buffer_font_family": "IntoneMono Nerd Font",
  "buffer_font_features": {
    "calt": true
  },
  "buffer_font_size": 15,
  "buffer_font_weight": 500,
  "buffer_line_height": {
    "custom": 1.7
  },
  "centered_layout": {
    "left_padding": 0.2
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "format_on_save": "off",
  "formatter": "auto",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "git_panel": {
    "dock": "left",
    "group_by": "staging"
  },
  "icon_theme": {
    "dark": "Colored Zed Icons Theme Dark",
    "light": "JetBrains New UI Icons (Light)",
    "mode": "dark"
  },
  "outline_panel": {
    "dock": "left"
  },
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enabled": true
  },
  "project_panel": {
    "auto_reveal_entries": false,
    "dock": "left",
    "entry_spacing": "standard",
    "folder_indicator": "chevron",
    "git_status": true,
    "hide_root": true
  },
  "show_edit_predictions": false,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true
  },
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hover"
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "terminal": {
    "alternate_scroll": "on",
    "font_family": "IntoneMono Nerd Font",
    "font_size": 13,
    "font_weight": 500,
    "line_height": "standard"
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "theme_overrides": {
    "Ayu Dark": {
      "editor.background": "#1a1a1a",
      "editor.gutter.background": "#1a1a1a",
      "background": "#333A4AFF",
      "text": "#BDBDBDFF",
      "icon": "#BDBDBDFF",
      "modified": "#59AAFFFF",
      "modified.background": "#1A262CFF",
      "modified.border": "#1B3847FF",
      "syntax": {
        "attribute": {
          "color": "#BDBDBDFF"
        },
        "boolean": {
          "color": "#689A00FF"
        },
        "comment": {
          "color": "#585858FF"
        },
        "comment.doc": {
          "color": "#629755FF"
        },
        "constant": {
          "color": "#916EBDFF"
        },
        "constructor": {
          "color": "#21A1BAFF"
        },
        "enum": {
          "color": "#FFBD57FF"
        },
        "function": {
          "color": "#FFBD57FF"
        },
        "keyword": {
          "color": "#E86620FF"
        },
        "link_text": {
          "color": "#E86620FF"
        },
        "link_uri": {
          "color": "#689A00FF"
        },
        "namespace": {
          "color": "#BDBDBDFF"
        },
        "number": {
          "color": "#689A00FF"
        },
        "operator": {
          "color": "#E86620FF"
        },
        "primary": {
          "color": "#BDBDBDFF"
        },
        "property": {
          "color": "#BDBDBDFF"
        },
        "punctuation": {
          "color": "#E86620FF"
        },
        "punctuation.bracket": {
          "color": "#E86620FF"
        },
        "punctuation.delimiter": {
          "color": "#E86620FF"
        },
        "punctuation.special": {
          "color": "#E86620FF"
        },
        "string": {
          "color": "#689A00FF"
        },
        "string.escape": {
          "color": "#E86620FF"
        },
        "string.regex": {
          "color": "#689A00FF"
        },
        "string.special.symbol": {
          "color": "#E86620FF"
        },
        "tag": {
          "color": "#21A1BAFF"
        },
        "title": {
          "color": "#BDBDBDFF"
        },
        "type": {
          "color": "#21A1BAFF"
        },
        "variable": {
          "color": "#BDBDBDFF"
        },
        "variable.parameter": {
          "color": "#BDBDBDFF"
        },
        "variant": {
          "color": "#BDBDBDFF"
        }
      },
      "panel.overlay_hover": "#333A4AFF",
      "version_control.modified": "#59AAFFFF"
    }
