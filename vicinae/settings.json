// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "activate_on_single_click": true,
   "input_server": {
      "enabled": false
   },
   "font": {
      "rendering": "native",
      "normal": {
         "family": "Adwaita Sans"
      }
   },
   "theme": {
      "dark": {
         "name": "noctalia",
         "icon_theme": "Papirus"
      }
   },
   "launcher_window": {
      "opacity": 0.7,
      "client_side_decorations": {
         "enabled": true,
         "rounding": 14,
         "border_width": 2,
         "shadow_size": 10
      },
      "layer_shell": {
         "layer": "overlay",
         "keyboard_interactivity": "exclusive",
         "enabled": true
      }
   },
   "favorites": [
      "applications:helium",
      "applications:obsidian",
      "applications:thunar",
      "applications:discord",
      "applications:steam",
      "applications:com.mitchellh.ghostty",
      "applications:dev.zed.Zed"
   ],
   "providers": {
      "applications": {
         "preferences": {
            "paths": [
               "/home/gaelen/.local/share/applications",
               "/home/gaelen/.local/share/flatpak/exports/share/applications",
               "/var/lib/flatpak/exports/share/applications",
               "/usr/share/applications"
            ]
         },
         "entrypoints": {
            "lmstudio": {
               "enabled": true
            }
         }
      },
      "clipboard": {
         "preferences": {
            "monitoring": true
         }
      },
      "core": {
         "entrypoints": {
            "search-builtin-icons": {
               "enabled": true
            }
         }
      },
      "files": {
         "preferences": {
            "autoIndexing": true,
            "excludedIndexingPaths": [
               "/home/gaelen/Documents/gaelens-vault",
               "/mnt/gaelen"
            ],
            "indexingPaths": [
               "/"
            ]
         }
      },
      "scripts": {
         "preferences": {
            "customDirs": [
               "/home/gaelen/bin"
            ]
         }
      },
      "snippets": {
         "enabled": false
      },
      "system": {
         "entrypoints": {
            "run": {
               "alias": "!"
            },
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "wm": {
         "enabled": false
      }
   }
}